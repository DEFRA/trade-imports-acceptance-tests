{
  "name": "trade-imports-acceptance-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=24.22.1"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "scripts": {
    "clean": "rm -rf allure-results && rm -rf allure-report",
    "test": "npm run clean && mocha --config .mocharc.json",
    "test:traces": "npm run clean && mocha --config .mocharc.traces.cjs",
    "test:all": "npm run clean && mocha --config .mocharc.all.cjs",
    "format": "prettier --write 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "format:check": "prettier --check 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "report": "allure generate allure-results --single-file --clean",
    "report:publish": "npm run report; ./bin/publish-tests.sh"
  },
  "dependencies": {
    "@azure/service-bus": "7.9.5",
    "fast-xml-parser": "5.7.0",
    "handlebars": "4.7.10",
    "https-proxy-agent": "9.0.0",
    "p-wait-for": "7.0.0",
    "pino": "10.4.0",
    "undici": "8.12.3",
    "uuid": "14.0.3",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "allure-commandline": "2.46.1",
    "allure-mocha": "3.7.1",
    "chai": "6.3.0",
    "dotenv": "18.0.9",
    "dotenv-flow": "4.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.1.7",
    "mocha": "12.0.3",
    "mocha-allure-reporter": "1.4.0",
    "mocha-steps": "1.3.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2"
  },
  "overrides": {
    "serialize-javascript": "7.1.4",
    "diff": "8.0.4",
    "uuid": "14.0.3"
  },
  "imports": {
    "#utils/*": "./test/utils/*",
    "#steps/*": "./test/steps/*"
  },
  "mocha": {
    "reporter": "allure-mocha",
    "reporterOptions": [
      "resultsDir=allure-results",
      "extraReporters=spec"
    ]
  }
}
