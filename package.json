{
  "name": "trade-imports-acceptance-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": "26.5.0"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "aliases": {
    "~": ".",
    "page-objects": "test/page-objects",
    "components": "test/components"
  },
  "scripts": {
    "clean": "rm -rf allure-results && rm -rf allure-report",
    "test": "npm run clean && mocha --config .mocharc.json",
    "format": "prettier --write 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "format:check": "prettier --check 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "report": "allure generate allure-results --single-file --clean",
    "report:publish": "npm run report; ./bin/publish-tests.sh"
  },
  "dependencies": {
    "@azure/logger": "1.0.4",
    "@azure/service-bus": "7.9.5",
    "@wdio/allure-reporter": "9.27.0",
    "@wdio/browserstack-service": "9.27.0",
    "@wdio/globals": "9.9.1",
    "@wdio/junit-reporter": "9.27.0",
    "@wdio/local-runner": "9.27.0",
    "@wdio/mocha-framework": "9.27.0",
    "@wdio/spec-reporter": "9.27.0",
    "esm-module-alias": "2.2.1",
    "fast-xml-parser": "5.7.0",
    "global-agent": "3.0.0",
    "handlebars": "4.7.9",
    "he": "1.2.0",
    "html-entities": "2.6.0",
    "https-proxy-agent": "9.0.0",
    "ip-address": "10.1.1",
    "p-wait-for": "5.0.2",
    "pino": "9.7.0",
    "proxy-agent": "8.0.1",
    "undici": "7.28.0",
    "uuid": "13.0.1",
    "ws": "8.21.0",
    "xml-formatter": "3.6.6"
  },
  "devDependencies": {
    "@wdio/cli": "9.27.0",
    "allure-commandline": "2.43.0",
    "allure-js-commons": "3.3.0",
    "allure-mocha": "3.7.1",
    "chai": "5.2.0",
    "dotenv": "16.5.0",
    "dotenv-flow": "4.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-wdio": "8.24.12",
    "husky": "9.1.7",
    "madge": "8.0.0",
    "mocha": "11.7.5",
    "mocha-allure-reporter": "1.4.0",
    "mocha-junit-reporter": "2.2.1",
    "mocha-multi-reporters": "1.5.1",
    "mocha-steps": "1.3.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "diff": "8.0.4",
    "ip-address": "10.1.1",
    "@grpc/grpc-js": "1.14.4",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "tmp": "0.2.7",
    "uuid": "13.0.1",
    "brace-expansion": "5.0.8",
    "ws": "8.21.0"
  },
  "imports": {
    "#utils/*": "./test/utils/*",
    "#steps/*": "./test/steps/*"
  },
  "mocha": {
    "reporter": "allure-mocha",
    "reporterOptions": [
      "resultsDir=allure-results",
      "extraReporters=spec"
    ]
  }
}
